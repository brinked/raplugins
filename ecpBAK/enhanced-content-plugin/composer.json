{
    "name": "rankaudit/enhanced-content-plugin",
    "description": "Autonomous SEO content agent for WordPress with human approval, plus the E-E-A-T editorial toolkit",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "scripts": {
        "lint": "find . -name \"*.php\" -not -path \"./vendor/*\" -not -path \"./docs/*\" -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs",
        "phpcs:fix": "phpcbf",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}